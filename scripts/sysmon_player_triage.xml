<Sysmon schemaversion="4.90">
  <HashAlgorithms>sha256</HashAlgorithms>
  <EventFiltering>
    <RuleGroup name="Verified-Windows-Player-Triage" groupRelation="or">
      <NetworkConnect onmatch="include">
        <Image condition="end with">zhenguojian.exe</Image>
        <Image condition="end with">powershell.exe</Image>
      </NetworkConnect>
      <DnsQuery onmatch="include">
        <Image condition="end with">zhenguojian.exe</Image>
        <Image condition="end with">powershell.exe</Image>
      </DnsQuery>
      <ProcessCreate onmatch="include">
        <ParentImage condition="end with">zhenguojian.exe</ParentImage>
      </ProcessCreate>
      <FileCreate onmatch="include">
        <Image condition="end with">zhenguojian.exe</Image>
      </FileCreate>
      <RegistryEvent onmatch="include">
        <Image condition="end with">zhenguojian.exe</Image>
      </RegistryEvent>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
